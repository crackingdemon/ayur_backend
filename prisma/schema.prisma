generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
  RECEPTIONIST
  PHARMACIST
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  members              OrganizationMember[]
  patients             Patient[]
  visits               Visit[]
  prescriptions        Prescription[]
  inventory            Inventory[]
  invoices             Invoice[]
  transactions         FinancialTransaction[]
  inventoryLedger      InventoryTransaction[]
  facilities           Facility[]
  panchakarma          PanchakarmaTreatment[]
}

model Facility {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  type           String       @default("CLINIC")
  address        String?
  phone          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  visits         Visit[]
  inventory      Inventory[]
  prescriptions  Prescription[]
  invoices       Invoice[]
  users          UserFacilityAccess[]
  transactions   FinancialTransaction[]
  inventoryLedger InventoryTransaction[]
  panchakarma    PanchakarmaTreatment[]
}



model UserFacilityAccess {
  userId     String
  facilityId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  
  @@id([userId, facilityId])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           UserRole @default(RECEPTIONIST)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  passwordHash   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships    OrganizationMember[]
  inventoryTransactions InventoryTransaction[]
  facilityAccess        UserFacilityAccess[]
  doctorVisits          Visit[] @relation("DoctorVisits")
}

model Patient {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  age             Int
  gender          String
  phone           String
  bloodGroup      String?
  allergies       String?
  pastHistory     String?
  drugHistory     String?
  personalHistory String?
  familyHistory   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  visits          Visit[]
  invoices        Invoice[]
  prescriptions   Prescription[]
  panchakarma     PanchakarmaTreatment[]

  @@index([organizationId, name])
  @@index([organizationId, phone])
}

model Visit {
  id             String   @id @default(uuid())
  organizationId String
  facilityId     String?
  patientId      String
  date           DateTime @default(now())
  doctor         String
  doctorId       String?  // Links to an actual doctor account
  doctorUser     User?    @relation("DoctorVisits", fields: [doctorId], references: [id])
  reason         String
  status         String   @default("Scheduled") // Scheduled, Waiting, In Consultation, Completed, Cancelled
  type           String   @default("Walk-in")   // Walk-in, Online, Call
  duration       Int      @default(30)          // Duration in minutes
  checkInTime    DateTime?
  checkoutTime   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility       Facility?    @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  
  modernEMR      ModernEMR?
  ayurvedicEMR   AyurvedicEMR?
  diagnosis      Diagnosis?
  prescription   Prescription?
  panchakarma    PanchakarmaTreatment[]

  @@index([organizationId, patientId])
  @@index([organizationId, date])
  @@index([organizationId, doctor])
}

model ModernEMR {
  id              String   @id @default(uuid())
  visitId         String   @unique
  chiefComplaints String?
  hpi             String?
  pulse           String?
  bp              String?
  temp            String?
  systemicExam    String?
  investigations  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  visit           Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model AyurvedicEMR {
  id              String   @id @default(uuid())
  visitId         String   @unique
  prakruti        String?
  vikruti         String?
  sara            String?
  samhanana       String?
  pramana         String?
  satmya          String?
  satva           String?
  aharaShakti     String?
  vyayamaShakti   String?
  vaya            String?
  nadi            String?
  mootra          String?
  mala            String?
  jihva           String?
  shabda          String?
  sparsha         String?
  drik            String?
  aakruti         String?
  vata            Int?     @default(0)
  pitta           Int?     @default(0)
  kapha           Int?     @default(0)
  affectedDhatu   String?
  srotodushtiType String?
  agni            String?
  ama             String?
  kostha          String?
  nidana          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  visit           Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model Diagnosis {
  id                 String   @id @default(uuid())
  visitId            String   @unique
  provisional        String?
  differential       String?
  ayurvedicDiagnosis String?
  samprapti          String?
  chikitsa           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  visit              Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

model Inventory {
  id             String   @id @default(uuid())
  organizationId String
  facilityId     String?
  name           String
  type           String   // Vati, Churna, Asava, Bhasma, Ghrita, Taila, etc.
  stockCount     Int      @default(0)
  unit           String   @default("units")
  price          Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility       Facility?    @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  prescriptionItems PrescriptionItem[]
  transactions   InventoryTransaction[]
}

model Prescription {
  id             String   @id @default(uuid())
  patientId      String
  visitId        String   @unique
  organizationId String
  facilityId     String?
  pathya         String?  // Recommended diet/lifestyle
  apathya        String?  // Restricted diet/lifestyle
  vihara         String?  // General lifestyle advice
  notes          String?
  status         String   @default("Pending") // Pending, Dispensed
  followUpDate   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit          Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility       Facility?    @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  items          PrescriptionItem[]
  invoice        Invoice?

  @@index([organizationId, patientId])
  @@index([organizationId, status])
}

model PrescriptionItem {
  id                 String   @id @default(uuid())
  prescriptionId     String
  inventoryId        String?  // Nullable if entered manually
  customMedicineName String?  // Used if inventoryId is null
  dosage             String   // e.g., "1-0-1", "2 tablets"
  frequency          String?  // e.g., "Twice a day"
  kala               String?  // e.g., "Pragbhakta", "Adhobhakta", "Before food"
  anupana            String?  // Vehicle e.g., "Warm Water", "Honey"
  duration           String   // e.g., "7 days", "1 month"
  quantity           Int?     // Total units to dispense
  instructions       String?
  
  // Invoicing fields stored at dispense time
  unitPrice          Float?
  discount           Float?
  totalPrice         Float?
  
  prescription       Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  inventory          Inventory?   @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
}

model InvoiceItem {
  id             String   @id @default(uuid())
  invoiceId      String
  description    String   // "Consultation Fee", "Ashwagandha Churna", etc.
  quantity       Int      @default(1)
  unitPrice      Float
  discount       Float    @default(0)
  totalPrice     Float
  
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String   @id @default(uuid())
  organizationId String
  facilityId     String?
  patientId      String
  prescriptionId String?  @unique
  subTotal       Float    @default(0)
  discount       Float    @default(0)
  totalAmount    Float
  status         String   @default("PENDING") // PENDING, PAID, CANCELLED
  paymentMethod  String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility       Facility?    @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  panchakarmaId  String?      @unique
  panchakarma    PanchakarmaTreatment? @relation(fields: [panchakarmaId], references: [id], onDelete: SetNull)
  items          InvoiceItem[]

  @@index([organizationId, patientId])
  @@index([organizationId, status])
  @@index([organizationId, date])
}

model FinancialTransaction {
  id             String   @id @default(uuid())
  organizationId String
  facilityId     String?
  type           String   // INCOME, EXPENSE
  amount         Float
  category       String   // Pharmacy Sales, Inventory Restock, Salary, etc.
  description    String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility       Facility?    @relation(fields: [facilityId], references: [id], onDelete: SetNull)
}

model InventoryTransaction {
  id             String   @id @default(uuid())
  organizationId String
  facilityId     String?
  inventoryId    String
  userId         String
  type           String   // SALE, RESTOCK, ADJUSTMENT, EXPIRED
  quantityChange Int      // positive or negative
  reason         String?
  createdAt      DateTime @default(now())
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility       Facility?    @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  inventory      Inventory    @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])
}

model PanchakarmaTreatment {
  id             String   @id @default(uuid())
  patientId      String
  visitId        String?
  organizationId String
  facilityId     String?
  name           String   // e.g., "Vamana", "Virechana"
  startDate      DateTime? 
  totalDays      Int
  status         String   @default("Active") // Active, Completed, Cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visit          Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facility       Facility?    @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  invoice        Invoice?

  days           PanchakarmaDay[]
}

model PanchakarmaDay {
  id             String   @id @default(uuid())
  treatmentId    String
  dayNumber      Int      // e.g. Day 1, Day 2
  date           DateTime? // The planned or executed date
  notes          String?  // Specific instructions for this day
  status         String   @default("Pending") // Pending, Completed, Missed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  treatment      PanchakarmaTreatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
}
